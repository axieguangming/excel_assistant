LLM_PROVIDER=remote
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
TRAIN_DATA_LOGGING=0

# 本地模型（LLM_PROVIDER=local 时生效）：仅允许回环地址
# LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_MODEL=qwen2.5-1.5b-instruct
# LOCAL_API_KEY=
# 由应用自动拉起 llama-server（需同时给出程序与模型来源）
# LOCAL_AUTO_START=1
# LOCAL_SERVER_PATH=llama\llama-server.exe
# 方式一：随包分发模型
# LOCAL_MODEL_PATH=models\qwen2.5-1.5b-instruct-q4_k_m.gguf
# 方式二：首次启动下载（推荐）
# LOCAL_MODEL_URL=https://models.example.com/qwen2.5-1.5b-instruct-q4_k_m.gguf
# LOCAL_MODEL_SHA256=
# LOCAL_MODEL_SIZE=
# LOCAL_CONTEXT_SIZE=8192
# LOCAL_STARTUP_TIMEOUT=90
# LOCAL_EXTRA_ARGS=--threads,4
